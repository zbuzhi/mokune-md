{
  "name": "mokune-md",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, source-preserving Markdown editor for macOS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build": "bash scripts/build.sh",
    "test": "node --test tests/*.test.mjs",
    "test:native": "bash scripts/test-native.sh",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:preview": "node tests/preview-browser.mjs",
    "test:scientific": "node tests/scientific-browser.mjs",
    "test:export": "node tests/export-browser.mjs",
    "test:navigation": "node tests/navigation-browser.mjs",
    "test:navigation:native": "bash scripts/test-navigation-native.sh",
    "test:workspace": "node tests/workspace-browser.mjs",
    "test:watcher": "bash scripts/test-workspace-watcher.sh",
    "test:typography": "node tests/typography-browser.mjs",
    "test:iterations": "node tests/iterations-browser.mjs 10",
    "test:iterations:native": "bash scripts/test-iterations-native.sh",
    "test:roadmap": "node tests/roadmap-browser.mjs 6",
    "test:roadmap:native": "bash scripts/test-roadmap-native.sh",
    "test:tabs": "node tests/tabs-browser.mjs",
    "test:trash": "node tests/trash-browser.mjs",
    "test:tabs:native": "bash scripts/test-tabs-native.sh",
    "test:extensions": "node tests/extensions-browser.mjs",
    "test:extensions:pdf": "bash scripts/test-extensions-pdf.sh",
    "test:performance": "node tests/performance-browser.mjs",
    "test:visual": "node tests/visual-browser.mjs",
    "test:visual:pdf": "bash scripts/test-visual-pdf.sh",
    "test:image-align:pdf": "bash scripts/test-image-align-pdf.sh",
    "test:webkit-interaction": "bash scripts/test-webkit-interaction.sh",
    "test:selection-transitions": "node tests/selection-transitions-browser.mjs",
    "test:pointer": "node tests/repeated-pointer-browser.mjs",
    "test:media-gestures": "node tests/media-gestures-browser.mjs",
    "test:fluidity": "node tests/editing-fluidity-browser.mjs",
    "test:polish": "node tests/editor-polish-browser.mjs",
    "test:polish:pdf": "bash scripts/test-polish-pdf.sh",
    "test:shortcut-hints": "node tests/shortcut-hints-browser.mjs",
    "test:session": "node tests/session-browser.mjs",
    "test:session:native": "bash scripts/test-session-native.sh",
    "test:session:app": "bash scripts/test-session-app.sh",
    "test:link-maintenance": "node tests/link-maintenance-browser.mjs",
    "test:workspace-move:native": "bash scripts/test-workspace-move-native.sh",
    "test:resources": "node tests/resources-browser.mjs",
    "test:resources:native": "bash scripts/test-resources-native.sh",
    "test:resources:app": "bash scripts/test-resources-app.sh",
    "test:conflict": "node tests/conflict-browser.mjs",
    "test:conflict:native": "bash scripts/test-merge-native.sh",
    "test:conflict:app": "bash scripts/test-conflict-app.sh",
    "test:app-icon": "bash scripts/verify-app-icon.sh \"dist/Mokune MD.app\"",
    "audit:licenses": "node scripts/build-web.mjs && node scripts/third-party.mjs && node scripts/audit-bundle-licenses.mjs",
    "test:markdown": "node tests/markdown-coverage-browser.mjs",
    "test:commonmark": "node scripts/test-commonmark.mjs",
    "test:table-transfer": "node tests/table-transfer-browser.mjs",
    "test:markdown:pdf": "bash scripts/test-markdown-pdf.sh",
    "test:callouts": "node tests/callouts-browser.mjs",
    "test:table-range": "node tests/table-range-browser.mjs",
    "test:performance:dense": "node tests/dense-performance-browser.mjs",
    "test:performance:native": "bash scripts/test-performance-native.sh",
    "test:highlight-lifecycle": "node tests/highlight-lifecycle-browser.mjs",
    "test:scientific-cache": "node tests/scientific-cache-browser.mjs",
    "test:release-smoke": "bash scripts/test-release-smoke.sh",
    "release:check": "node scripts/release-gate.mjs",
    "release:check:source": "node scripts/release-gate.mjs --public-source",
    "release:check:binary": "node scripts/release-gate.mjs --public-binary --app \"dist/Mokune MD.app\"",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.62.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  }
}
